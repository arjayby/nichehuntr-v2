{
	"name": "nichehuntr-v2",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"typescript": "^6",
			"lucide-react": "^1.23.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.7",
			"react-dom": "^19.2.7",
			"sonner": "^2.0.7",
			"tailwindcss": "^4.3.2",
			"convex": "^1.42.1",
			"better-auth": "1.6.15",
			"@convex-dev/better-auth": "^0.12.5",
			"@convex-dev/polar": "^0.9.2",
			"@types/react": "^19.2.17",
			"@types/react-dom": "^19.2.3",
			"alchemy": "^0.93.12"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web",
		"dev:server": "turbo run dev -F @nichehuntr-v2/backend",
		"dev:setup": "turbo run dev:setup -F @nichehuntr-v2/backend",
		"deploy": "turbo run deploy -F @nichehuntr-v2/infra",
		"destroy": "turbo run destroy -F @nichehuntr-v2/infra",
		"check": "biome check --write .",
		"test": "turbo run test"
	},
	"dependencies": {
		"@nichehuntr-v2/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@cloudflare/workers-types": "^4.20260702.1",
		"@nichehuntr-v2/config": "workspace:*",
		"@types/node": "^22.13.14",
		"turbo": "^2.10.2",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.14"
}
